<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%-- Mensajes al usuario: "error" de la peticion actual y mensajes flash guardados en sesion antes de un redirect --%>
<style>
    .alerta {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-weight: 600;
        font-size: 14px;
    }
    .alerta-exito { background: #dcfce7; color: #166534; border: 1px solid #86efac; }
    .alerta-error { background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; }
</style>
<c:if test="${not empty error}">
    <div class="alerta alerta-error" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i> <c:out value="${error}"/>
    </div>
</c:if>
<c:if test="${not empty sessionScope.flashError}">
    <div class="alerta alerta-error" role="alert">
        <i class="fa-solid fa-circle-exclamation"></i> <c:out value="${sessionScope.flashError}"/>
    </div>
    <c:remove var="flashError" scope="session"/>
</c:if>
<c:if test="${not empty sessionScope.flashExito}">
    <div class="alerta alerta-exito" role="status">
        <i class="fa-solid fa-circle-check"></i> <c:out value="${sessionScope.flashExito}"/>
    </div>
    <c:remove var="flashExito" scope="session"/>
</c:if>
